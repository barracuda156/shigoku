ta){\r\n\t\t$('[id=\"prev\"]').addClass('disabled');\r\n\t\t}\r\n\t  }\r\n\t  \r\n\t  function next_btn(){\r\n\t\tvar a1 = $(\".mass .episodes li a.active\").attr(\"data-pop\");\r\n\t\ta1 = parseFloat(a1)+1;\r\n\t\tif(a1 == end){\r\n\t\t$('[id=\"next\"]').addClass('disabled');\r\n\t\t}\r\n\t\tif(a1 !== sta){\r\n\t\t$('[id=\"prev\"]').removeClass('disabled');\r\n\t\t}\r\n\t\tif(a1 < end || a1 == end){\r\n\t\t$(\".mass .episodes li a.active\").removeClass('active');\r\n\t\t$(\"[data-pop=\"+a1+\"]\").addClass('active').trigger('click');\r\n\t\t}\r\n\t  }\r\n\t  \r\n\r\n$(\"#rsz .collps\").click(function(){\r\n\t$(this).css('display','none');\r\n\t$(\"#resize\").css(\"max-width\", \"fit-content\");\r\n\t$('#rsz .expnd').css('display','block');\r\n\t});\r\n\t\r\n$(\"#rsz .expnd\").click(function(){\r\n\t$(this).css('display','none');\r\n\t$(\"#resize\").css(\"max-width\", \"none\");\r\n\t$('#rsz .collps').css('display','block');\r\n\t});\r\n\t\r\n\t$(document).on('keypress',function(e) {\r\n    if(e.which == 110) {\r\n        $('#next').click(); \r\n    }\r\n\t if(e.keyCode == 112) {\r\n        $('#prev').click(); \r\n    }\r\n});\r\n\r\nif(localstorage_cus(\"player_autonext\", 0, 2) === null){\r\n\tlocalstorage_cus(\"player_autonext\", 1, 1);\r\n\tvar autonext = 1;\r\n}else{\r\n\tvar autonext = parseInt(localstorage_cus(\"player_autonext\", 0, 2));\r\n}\r\n\r\nfunction updateAutonext() {\r\n  autonext = parseInt(localstorage_cus(\"player_autonext\", 0, 2));\r\n}\r\nupdateAutonext();\r\nsetInterval(function() {\r\n  updateAutonext();\r\n}, 5000);\r\n\r\nwindow.addEventListener(\"message\", function(e) {\r\n  if (autonext == 1) {\r\n  if (\"https:\/\/bunnycdn.se\" === e.origin && \"videoEnded\" === e.data && act1 !== end) {\r\n    next_btn();\r\n  }\r\n  }\r\n\r\n});\r\n\r\n\r\n\r\n\t\t\r\n\t\t\r\n\tfunction localstorage_cus(value,item,type){\r\n    try {\r\n\t\tif(type == 1){\r\n        localStorage.setItem(value, item);\r\n\t\t}\r\n\t\tif(type == 2){\r\n        return l